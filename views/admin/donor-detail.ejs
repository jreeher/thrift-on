<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donor #<%= donor.id %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/admin-header', { active: 'donations' }) %>

  <main class="admin-page">
    <a class="back-link" href="/admin/donations">&larr; Back to Donors</a>
    <h1>Donor #<%= donor.id %></h1>

    <p class="admin-hint">
      <%= donor.phone_number %> &middot; registered <%= donor.created_at.toLocaleDateString() %>
    </p>

    <p class="success-banner">Current store credit balance: $<%= (balanceCents / 100).toFixed(2) %></p>

    <h2>Items Donated (<%= items.length %>)</h2>
    <% if (items.length === 0) { %>
      <p class="empty-state">No items on record for this donor.</p>
    <% } else { %>
      <div class="bins-table-wrap">
        <table class="bins-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Category</th>
              <th>Status</th>
              <th>Bin</th>
              <th>Price</th>
              <th>Donated</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach((item) => { %>
              <tr>
                <td><%= item.title || '(untitled draft)' %></td>
                <td><%= (item.category || '—').replace('_', ' ') %></td>
                <td><%= statusLabels[item.status] || item.status %></td>
                <td><%= item.bin_number || '—' %></td>
                <td><%= item.price_current_cents != null ? '$' + (item.price_current_cents / 100).toFixed(2) : '—' %></td>
                <td><%= item.created_at.toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <h2>Store Credit History</h2>
    <% if (ledger.length === 0) { %>
      <p class="empty-state">No store credit activity for this donor.</p>
    <% } else { %>
      <div class="bins-table-wrap">
        <table class="bins-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Reason</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody>
            <%
              const ledgerReasonLabels = {
                consignment_payout: 'Consignment payout',
                redeemed_at_checkout: 'Redeemed at checkout',
                return_credit_shortfall: 'Return credit'
              };
            %>
            <% ledger.forEach((entry) => { %>
              <tr>
                <td><%= entry.created_at.toLocaleDateString() %></td>
                <td><%= ledgerReasonLabels[entry.reason] || entry.reason %></td>
                <td class="<%= entry.amount_cents >= 0 ? 'ledger-credit' : 'ledger-debit' %>">
                  <%= entry.amount_cents >= 0 ? '+' : '−' %>$<%= (Math.abs(entry.amount_cents) / 100).toFixed(2) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
